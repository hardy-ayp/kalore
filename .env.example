# Kalore Environment Variables Template
# Copy this file to .env or use env.json for Flutter --dart-define-from-file

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# CalorieAPI Admin Key (Optional: for direct nutrition database search)
# https://calorieapiadmin.com/
CALORIE_API_KEY=your_calorie_api_key_here

# CalorieNinjas API Key (Optional: for natural language nutrition & OCR)
# https://calorieninjas.com/
CALORIE_NINJAS_KEY=your_calorie_ninjas_key_here
